import Mathlib.GroupTheory.Nilpotent
import Mathlib.Topology.Algebra.ClopenNhdofOne

/-! A finite 2-group quotient is generated by one specified inertia group if
no proper open normal subgroup can contain that inertia group and the kernel. -/
noncomputable section
namespace RiemannReduction.GaussianTower
variable {G : Type*} [Group G]

theorem core_is_two_group (H K : Subgroup G) (r : ℕ)
    (powH : ∀ g : G, g ^ (2 ^ r) ∈ H)
    (squareK : ∀ g ∈ H, g ^ 2 ∈ K) :
    IsPGroup 2 (G ⧸ K.normalCore) := by
  intro x
  obtain ⟨g, rfl⟩ := QuotientGroup.mk'_surjective K.normalCore x
  refine ⟨r+1, ?_⟩
  rw [← map_pow]
  apply (QuotientGroup.eq_one_iff _).2
  intro b
  have h := squareK _ (powH (b * g * b⁻¹))
  simpa only [← pow_mul, ← pow_succ, conj_pow] using h

theorem inertia_surjects [TopologicalSpace G] [IsTopologicalGroup G]
    (N I : Subgroup G) [N.Normal] [Finite (G ⧸ N)]
    (two : IsPGroup 2 (G ⧸ N)) (hN : IsOpen (N : Set G))
    (full : ∀ (U : Subgroup G) [U.Normal], IsOpen (U : Set G) → N ≤ U → I ≤ U → U = ⊤) :
    I.map (QuotientGroup.mk' N) = ⊤ := by
  classical
  let π := QuotientGroup.mk' N
  by_contra hn
  obtain ⟨M, hm, hi⟩ := (eq_top_or_exists_le_coatom (I.map π)).resolve_left hn
  have := two.isNilpotent
  have : M.Normal := Subgroup.NormalizerCondition.normal_of_coatom M Group.normalizerCondition_of_isNilpotent hm
  let U := M.comap π
  have hker : N ≤ U := by
    intro g hg
    change π g ∈ M
    rw [show π g = 1 from (QuotientGroup.eq_one_iff _).2 hg]
    exact M.one_mem
  have hop := Subgroup.isOpen_mono hker hN
  have htop := full U hop hker ((Subgroup.map_le_iff_le_comap).mp hi)
  apply hm.1
  apply top_unique
  intro m _
  obtain ⟨g, rfl⟩ := QuotientGroup.mk'_surjective N m
  exact (show g ∈ U by rw [htop]; exact Subgroup.mem_top _)

#print axioms core_is_two_group
#print axioms inertia_surjects
end RiemannReduction.GaussianTower
